# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=https://hibkysovkhcehfalzdag.supabase.co

# 서버 전용 Secret API Key. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Vercel 공개 주소에서 사용할 가족 공용 비밀번호입니다. 10자 이상으로 설정하세요.
DASHBOARD_ACCESS_PASSWORD=change-this-to-a-long-family-password

# 이 전용 프로젝트에서 기존 기록을 소유한 Supabase Auth 사용자 ID를 지정합니다.
# 다른 Supabase 프로젝트의 사용자 ID를 재사용하지 마세요.
SUPABASE_HOUSEHOLD_USER_ID=your-dedicated-project-user-uuid

# 미국 주식 시세 조회용. 비워두면 미국 주식 자동 시세만 생략됩니다.
FINNHUB_API_KEY=
