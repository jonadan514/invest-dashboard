# Supabase 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# 서버 전용 Secret API Key. 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Vercel 공개 주소에서 사용할 가족 공용 비밀번호입니다. 10자 이상으로 설정하세요.
DASHBOARD_ACCESS_PASSWORD=change-this-to-a-long-family-password

# Supabase Auth 사용자가 여러 명일 때만 지정합니다.
# SUPABASE_HOUSEHOLD_USER_ID=00000000-0000-0000-0000-000000000000

# 미국 주식 시세 조회용. 비워두면 미국 주식 자동 시세만 생략됩니다.
FINNHUB_API_KEY=
